{
  "manifest_version": 3,
  "name": "楽曲制作アーカイブ",
  "version": "1.2.0",
  "description": "Suno・主要AI（ChatGPT/Claude/Gemini等）から曲情報・歌詞を収集し、横断検索で一元管理",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "activeTab",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "https://suno.com/*",
    "https://*.suno.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://copilot.microsoft.com/*",
    "https://copilot.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://poe.com/*"
  ],
  "background": {
    "service_worker": "dist/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://suno.com/song/*", "https://*.suno.com/song/*"],
      "js": ["dist/suno-song.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://suno.com/create*",
        "https://*.suno.com/create*",
        "https://suno.com/playlist/*",
        "https://*.suno.com/playlist/*",
        "https://suno.com/me*",
        "https://*.suno.com/me*"
      ],
      "js": ["dist/suno-list.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://copilot.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://poe.com/*"
      ],
      "js": ["dist/ai-chat.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "ui/popup/index.html",
    "default_title": "楽曲制作アーカイブ",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "ui/dashboard/index.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
