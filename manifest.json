{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "version": "1.2.3",
  "description": "__MSG_extDescription__",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "activeTab",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "https://suno.com/*",
    "https://*.suno.com/*",
    "https://studio-api.prod.suno.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://copilot.microsoft.com/*",
    "https://copilot.com/*",
    "https://perplexity.ai/*",
    "https://*.perplexity.ai/*",
    "https://poe.com/*"
  ],
  "background": {
    "service_worker": "dist/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://suno.com/song/*",
        "https://*.suno.com/song/*",
        "https://suno.com/s/*",
        "https://*.suno.com/s/*",
        "https://suno.com/create*",
        "https://*.suno.com/create*",
        "https://suno.com/playlist/*",
        "https://*.suno.com/playlist/*",
        "https://suno.com/me*",
        "https://*.suno.com/me*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://copilot.com/*",
        "https://perplexity.ai/*",
        "https://*.perplexity.ai/*",
        "https://poe.com/*"
      ],
      "js": ["dist/dialog-host.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://suno.com/song/*",
        "https://*.suno.com/song/*",
        "https://suno.com/s/*",
        "https://*.suno.com/s/*"
      ],
      "js": ["dist/suno-song.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://suno.com/create*",
        "https://*.suno.com/create*",
        "https://suno.com/playlist/*",
        "https://*.suno.com/playlist/*",
        "https://suno.com/me*",
        "https://*.suno.com/me*"
      ],
      "js": ["dist/suno-list.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://copilot.com/*",
        "https://perplexity.ai/*",
        "https://*.perplexity.ai/*",
        "https://poe.com/*"
      ],
      "js": ["dist/ai-chat.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "ui/popup/index.html",
    "default_title": "__MSG_extActionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "ui/dashboard/index.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["ui/shared/dialog-host-page.css"],
      "matches": [
        "https://suno.com/*",
        "https://*.suno.com/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://copilot.com/*",
        "https://perplexity.ai/*",
        "https://*.perplexity.ai/*",
        "https://poe.com/*"
      ]
    }
  ]
}
