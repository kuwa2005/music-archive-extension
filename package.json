{
  "name": "music-archive-extension",
  "version": "1.0.0",
  "private": true,
  "description": "Suno・ChatGPT 楽曲制作アーカイブ Chrome 拡張",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "icons": "node scripts/generate-icons.mjs",
    "package": "node scripts/package-extension.mjs",
    "test:suno-date": "node scripts/_tmp-parse-song-date.mjs && node scripts/test-suno-date.mjs && node scripts/test-save-suno-created-at.mjs",
    "test:similarity-tree": "node scripts/test-similarity-tree.mjs",
    "test:instrumental": "node scripts/test-instrumental-capture.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "linkedom": "^0.18.12"
  },
  "dependencies": {
    "dexie": "^4.0.11"
  }
}
